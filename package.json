{
  "name": "expo-shopsavvy",
  "version": "0.1.0",
  "description": "Expo config plugin and React hooks for product search, price comparison, price history, and deals powered by ShopSavvy",
  "keywords": [
    "expo",
    "react-native",
    "expo-config-plugin",
    "config-plugin",
    "shopsavvy",
    "barcode",
    "price-comparison",
    "shopping",
    "ecommerce"
  ],
  "homepage": "https://shopsavvy.com/integrations/expo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopsavvy/expo-shopsavvy.git"
  },
  "bugs": {
    "url": "https://github.com/shopsavvy/expo-shopsavvy/issues"
  },
  "license": "MIT",
  "author": "ShopSavvy by Monolith Technologies, Inc.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "plugin/build",
    "app.plugin.js"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && tsup plugin/src/withShopsavvy.ts --format cjs --dts --clean --out-dir plugin/build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@shopsavvy/sdk": "^1.4.0"
  },
  "peerDependencies": {
    "expo": ">=50.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@expo/config": "^57.0.0",
    "@happy-dom/global-registrator": "^20.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "expo": "^57.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
